{
  "name": "leavetracker-pro",
  "version": "1.0.0",
  "description": "LeaveTracker Pro - leave management",
  "main": "main.js",
  "author": "LeaveTracker",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.leavetracker.pro",
    "productName": "LeaveTracker Pro",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "LeaveTracker-Pro.exe" }
  }
}
